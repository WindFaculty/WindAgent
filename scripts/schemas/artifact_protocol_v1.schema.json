{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WindAgent Artifact Protocol v1",
  "description": "Canonical artifact schema for WindAgent Architecture V2 Production Hardening. Single source of truth.",
  "type": "object",
  "required": [
    "protocol_version",
    "generated_at",
    "source_sha",
    "verified_sha",
    "branch",
    "worktree_clean",
    "commands",
    "results",
    "failures",
    "warnings",
    "artifact_hashes",
    "verdict"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "enum": ["phase_report", "evidence_bundle"],
      "description": "Artifact subtype; evidence_bundle enables the stricter Phase 2 contract"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0",
      "description": "Artifact protocol version (semver), fixed at 1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when artifact was generated"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Git commit SHA at time of artifact generation (40 lowercase hex chars)"
    },
    "verified_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Git commit SHA that was verified against the artifact (40 lowercase hex chars)"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Git branch name at generation time"
    },
    "worktree_clean": {
      "type": "boolean",
      "description": "Whether the worktree was clean at generation time"
    },
    "environment": {
      "type": "object",
      "required": ["git", "runtime", "tools"],
      "properties": {
        "git": {
          "type": "object",
          "required": ["source_sha", "verified_sha", "branch", "worktree_clean"],
          "properties": {
            "source_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "verified_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "branch": { "type": "string", "minLength": 1 },
            "worktree_clean": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": ["os", "python", "uv", "node", "npm", "postgres"],
          "properties": {
            "os": { "type": "string" },
            "os_version": { "type": "string" },
            "python": { "type": "string" },
            "python_implementation": { "type": "string" },
            "uv": { "type": ["string", "null"] },
            "node": { "type": ["string", "null"] },
            "npm": { "type": ["string", "null"] },
            "postgres": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "description": "List of commands executed with their receipts",
      "items": {
        "$ref": "command_receipt_v1.schema.json"
      }
    },
    "results": {
      "type": "object",
      "description": "Structured test/execution results",
      "additionalProperties": true
    },
    "failures": {
      "type": "array",
      "description": "List of failures encountered",
      "items": {
        "type": "object",
        "required": ["check", "message", "severity"],
        "properties": {
          "check": {
            "type": "string",
            "description": "Name of the check that failed"
          },
          "message": {
            "type": "string",
            "description": "Failure description"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
            "description": "Failure severity level"
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "description": "List of warnings (non-blocking) with structured metadata",
      "items": {
        "type": "object",
        "required": ["check", "message", "severity", "accepted", "rationale"],
        "properties": {
          "check": {
            "type": "string",
            "description": "Name of the check that produced warning"
          },
          "message": {
            "type": "string",
            "description": "Warning description"
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"],
            "description": "Warning severity level"
          },
          "accepted": {
            "type": "boolean",
            "description": "Whether this warning has been explicitly accepted"
          },
          "rationale": {
            "type": "string",
            "description": "Justification for accepting or rejecting the warning"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_hashes": {
      "type": "object",
      "description": "SHA256 hashes of generated artifact files (64 lowercase hex chars)",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 1,
      "description": "Mapping of artifact filename to SHA256 hash"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"],
      "description": "Overall verdict for this phase"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "evidence_bundle" }
        },
        "required": ["artifact_type"]
      },
      "then": {
        "required": ["environment"]
      }
    }
  ],
  "additionalProperties": false
}
