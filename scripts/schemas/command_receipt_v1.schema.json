{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WindAgent Command Receipt v1",
  "description": "Schema for individual command receipts generated by the evidence pipeline",
  "type": "object",
  "required": [
    "command_id",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "duration_ms",
    "exit_code",
    "stdout_tail",
    "stderr_tail",
    "environment",
    "expected_exit_codes",
    "result",
    "stdout_sha256",
    "stderr_sha256",
    "output_sha256",
    "log_paths"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0",
      "description": "Command receipt protocol version (semver), fixed at 1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when receipt was generated"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unique identifier for this command"
    },
    "command": {
      "type": "string",
      "description": "The command that was executed"
    },
    "cwd": {
      "type": "string",
      "description": "Working directory where command was executed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when command started"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when command finished"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Execution duration in milliseconds"
    },
    "exit_code": {
      "type": "integer",
      "description": "Process exit code"
    },
    "stdout_tail": {
      "type": "string",
      "description": "Last 500 chars of stdout"
    },
    "stderr_tail": {
      "type": "string",
      "description": "Last 500 chars of stderr"
    },
    "environment": {
      "type": "object",
      "required": ["os", "python", "uv", "git_sha"],
      "properties": {
        "os": { "type": "string" },
        "python": { "type": "string" },
        "uv": { "type": "string" },
        "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "description": "Environment snapshot at execution time"
    },
    "expected_exit_codes": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1,
      "description": "Expected exit codes for success"
    },
    "result": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE", "TIMEOUT", "INTERRUPTED"],
      "description": "Execution result classification"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 hash of the exact persisted stdout+stderr bytes"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 hash of the exact persisted redacted stdout bytes"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 hash of the exact persisted redacted stderr bytes"
    },
    "log_paths": {
      "type": "object",
      "description": "Paths to persisted stdout/stderr log files",
      "required": ["stdout_log", "stderr_log"],
      "properties": {
        "stdout_log": { "type": "string" },
        "stderr_log": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
