{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WindAgent Artifact Schema",
  "description": "Standardized artifact schema for all phase artifacts in Architecture V2 Production Hardening",
  "type": "object",
  "required": [
    "protocol_version",
    "generated_at",
    "source_sha",
    "verified_sha",
    "branch",
    "worktree_clean",
    "commands",
    "results",
    "failures",
    "warnings",
    "artifact_hashes",
    "verdict"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Artifact protocol version (semver), e.g., 1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when artifact was generated"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Git commit SHA at time of artifact generation (40 hex chars)"
    },
    "verified_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Git commit SHA that was verified against the artifact (40 hex chars)"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Git branch name at generation time"
    },
    "worktree_clean": {
      "type": "boolean",
      "description": "Whether the worktree was clean at generation time"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "duration_ms", "stdout_tail", "stderr_tail"],
        "properties": {
          "command": {
            "type": "string",
            "description": "The command that was executed"
          },
          "exit_code": {
            "type": "integer",
            "description": "Process exit code"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Execution duration in milliseconds"
          },
          "stdout_tail": {
            "type": "string",
            "description": "Last 500 chars of stdout"
          },
          "stderr_tail": {
            "type": "string",
            "description": "Last 500 chars of stderr"
          }
        }
      },
      "minItems": 1,
      "description": "List of commands executed with their receipts"
    },
    "results": {
      "type": "object",
      "description": "Structured test/execution results",
      "additionalProperties": true
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "message", "severity"],
        "properties": {
          "check": {
            "type": "string",
            "description": "Name of the check that failed"
          },
          "message": {
            "type": "string",
            "description": "Failure description"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
            "description": "Failure severity level"
          }
        }
      },
      "description": "List of failures encountered"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "message"],
        "properties": {
          "check": {
            "type": "string",
            "description": "Name of the check that produced warning"
          },
          "message": {
            "type": "string",
            "description": "Warning description"
          }
        }
      },
      "description": "List of warnings (non-blocking)"
    },
    "artifact_hashes": {
      "type": "object",
      "description": "SHA256 hashes of generated artifact files",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 1,
      "description": "Mapping of artifact filename to SHA256 hash"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"],
      "description": "Overall verdict for this phase"
    }
  },
  "additionalProperties": false
}