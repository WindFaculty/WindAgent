{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@windagent/ui": ["../../frontend/packages/ui/src/index.ts"],
      "@windagent/ui/*": ["../../frontend/packages/ui/src/*"],
      "@windagent/app": ["../../frontend/app/src/index.ts"],
      "@windagent/app/src/*": ["../../frontend/app/src/*"],
      "@windagent/app/*": ["../../frontend/app/src/*"],
      "@windagent/api-contracts": ["../../frontend/packages/api-contracts/src/index.ts"],
      "@windagent/api-contracts/*": ["../../frontend/packages/api-contracts/src/*"],
      "@windagent/api-client": ["../../frontend/packages/api-client/src/index.ts"],
      "@windagent/api-client/*": ["../../frontend/packages/api-client/src/*"],
      "@windagent/realtime": ["../../frontend/packages/realtime/src/index.ts"],
      "@windagent/realtime/*": ["../../frontend/packages/realtime/src/*"],
      "@windagent/studio-shell": ["../../frontend/packages/studio-shell/src/index.ts"],
      "@windagent/studio-shell/*": ["../../frontend/packages/studio-shell/src/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}