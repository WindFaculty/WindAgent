        "TEXT_TO_VIDEO",
        "IMAGE_TO_VIDEO",
        "FRAMES_TO_VIDEO",
        "INGREDIENTS_TO_VIDEO",
        "VIDEO_EXTENSION",
        "VIDEO_TO_VIDEO",
        "TEXT_TO_IMAGE"
      ],
      "title": "GenerationMode",
      "type": "string"
    },
    "GenerationRecord": {
      "additionalProperties": true,
      "description": "Aggregated record: request + candidates + selected result.",
