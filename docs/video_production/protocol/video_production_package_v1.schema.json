        "dialogue_id": {
          "title": "Dialogue Id",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "delivery": {
          "default": "",
          "title": "Delivery",
          "type": "string"
        }
      },
      "required": [
        "dialogue_id",
        "scene_id",
        "character_id",
        "order",
        "text"
      ],
      "title": "DialogueLine",
      "type": "object"
    },
    "FinalDeliverable": {
      "additionalProperties": true,
      "description": "Published final video deliverable bound to a revision.",
      "properties": {
        "deliverable_id": {
          "title": "Deliverable Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "mime_type": {
          "default": "video/mp4",
          "title": "Mime Type",
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "uri": {
          "default": "",
          "title": "Uri",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "deliverable_id",
        "project_id",
        "revision_id",
        "content_hash",
        "duration_seconds"
      ],
      "title": "FinalDeliverable",
      "type": "object"
    },
    "GenerationCandidate": {
      "additionalProperties": true,
