        "status": {
          "$ref": "#/$defs/GenerationStatus",
          "default": "SUBMITTED"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "title": "GenerationRecord",
      "type": "object"
    },
    "GenerationRequest": {
      "additionalProperties": true,
      "description": "Idempotent request to a media generation provider.",
