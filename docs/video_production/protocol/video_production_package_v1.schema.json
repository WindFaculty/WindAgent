          "type": "string"
        },
        "prompt_version": {
          "default": "1.0.0",
          "title": "Prompt Version",
          "type": "string"
        },
        "reference_hashes": {
          "items": {
            "type": "string"
          },
          "title": "Reference Hashes",
          "type": "array"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/GenerationStatus",
          "default": "SUBMITTED"
