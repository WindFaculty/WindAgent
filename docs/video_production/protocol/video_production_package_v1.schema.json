        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "generation_mode": {
          "$ref": "#/$defs/GenerationMode"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "prompt_version": {
          "default": "1.0.0",
          "title": "Prompt Version",
