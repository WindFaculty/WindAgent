          "type": "array"
        },
        "request_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Request Hash",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
