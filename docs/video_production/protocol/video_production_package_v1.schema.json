    "RequiredArtifactType": {
      "description": "Artifact a dependency edge requires from its predecessor (Phase 9).\n\n`NONE` means the edge is a pure ordering/scheduling hint; a non-NONE value\nmeans the successor cannot start until the predecessor produced that\nartifact (e.g. a tail frame for continuity, both clips for a transition).",
      "enum": [
        "NONE",
        "TAIL_FRAME",
        "FIRST_FRAME",
        "LAST_FRAME",
        "FULL_CLIP",
        "REFERENCE_IMAGE"
      ],
      "title": "RequiredArtifactType",
      "type": "string"
    },
