{
  "$defs": {
    "ApprovalDecision": {
      "additionalProperties": true,
      "description": "Approval record bound to a specific revision + content hash.",
      "properties": {
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "target_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Target Hash",
          "type": "string"
        },
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ApprovalRole",
          "default": "OWNER"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecisionType"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "project_id",
        "revision_id",
        "target_hash",
        "actor",
        "decision"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "ApprovalDecisionType": {
      "description": "Outcome of an ApprovalDecision.",
      "enum": [
        "APPROVED",
        "REJECTED"
      ],
      "title": "ApprovalDecisionType",
      "type": "string"
    },
    "ApprovalRole": {
      "description": "Role of an approval actor.",
      "enum": [
        "OWNER",
        "DIRECTOR",
        "QUALITY_REVIEWER",
        "LEGAL",
        "ADMIN"
      ],
      "title": "ApprovalRole",
      "type": "string"
    },
    "ApprovalState": {
      "additionalProperties": true,
      "description": "Current approval state of a revision's package.",
      "properties": {
        "approvals": {
          "items": {
            "$ref": "#/$defs/ApprovalDecision"
          },
          "title": "Approvals",
          "type": "array"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        }
      },
      "title": "ApprovalState",
      "type": "object"
    },
    "AssetAcquisitionRecord": {
      "additionalProperties": true,
      "description": "Provenance of an acquired asset.",
      "properties": {
        "source_type": {
          "$ref": "#/$defs/AssetSourceType"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "license_state": {
          "$ref": "#/$defs/LicenseState",
          "default": "UNKNOWN"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "source_type"
      ],
      "title": "AssetAcquisitionRecord",
      "type": "object"
    },
    "AssetSourceType": {
      "description": "Origin of a ReferenceAsset.",
      "enum": [
        "GENERATED",
        "INTERNET",
        "UPLOADED",
        "PROVIDER"
      ],
      "title": "AssetSourceType",
      "type": "string"
    },
    "CameraMovement": {
      "description": "Canonical camera movements.",
      "enum": [
        "STATIC",
        "PAN",
        "TILT",
        "DOLLY",
        "TRACK",
        "CRANE",
        "HANDHELD"
      ],
      "title": "CameraMovement",
      "type": "string"
    },
    "CharacterBible": {
      "additionalProperties": true,
      "description": "Canonical identity reference catalog entry for a character.",
      "properties": {
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/CharacterRole",
          "default": "SUPPORTING"
        },
        "visual_traits": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Visual Traits",
          "type": "object"
        },
        "costume_descriptions": {
          "items": {
            "type": "string"
          },
          "title": "Costume Descriptions",
          "type": "array"
        },
        "portrait_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Portrait Asset Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "character_id",
        "name"
      ],
      "title": "CharacterBible",
      "type": "object"
    },
    "CharacterRole": {
      "description": "Role classification within a CharacterBible.",
      "enum": [
        "LEAD",
        "SUPPORTING",
        "EXTRAS"
      ],
      "title": "CharacterRole",
      "type": "string"
    },
    "CinematicPlan": {
      "additionalProperties": true,
      "description": "Shot plan for a revision: shots + typed dependency graph.",
      "properties": {
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/ShotDependencyGraph"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "plan_id",
        "project_id",
        "revision_id"
      ],
      "title": "CinematicPlan",
      "type": "object"
    },
    "ContinuityState": {
      "additionalProperties": true,
      "description": "Per-shot continuity snapshot (package v1 schema, Phase 6).",
      "properties": {
        "state_id": {
          "title": "State Id",
          "type": "string"
        },
        "shot_id": {
          "title": "Shot Id",
          "type": "string"
        },
        "character_states": {
          "additionalProperties": true,
          "title": "Character States",
          "type": "object"
        },
        "location_state": {
          "additionalProperties": true,
          "title": "Location State",
          "type": "object"
        },
        "prop_states": {
          "additionalProperties": true,
          "title": "Prop States",
          "type": "object"
        },
        "camera_state": {
          "additionalProperties": true,
          "title": "Camera State",
          "type": "object"
        },
        "must_preserve": {
          "items": {
            "type": "string"
          },
          "title": "Must Preserve",
          "type": "array"
        },
        "allowed_changes": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Changes",
          "type": "array"
        }
      },
      "required": [
        "state_id",
        "shot_id"
      ],
      "title": "ContinuityState",
      "type": "object"
    },
    "CreativeBrief": {
      "additionalProperties": true,
      "description": "Creative direction and production constraints for a project.",
      "properties": {
        "brief_id": {
          "title": "Brief Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "genre": {
          "default": "",
          "title": "Genre",
          "type": "string"
        },
        "logline": {
          "default": "",
          "title": "Logline",
          "type": "string"
        },
        "tone": {
          "default": "",
          "title": "Tone",
          "type": "string"
        },
        "audience": {
          "default": "",
          "title": "Audience",
          "type": "string"
        },
        "target_duration_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Target Duration Seconds",
          "type": "integer"
        },
        "aspect_ratio": {
          "default": "16:9",
          "title": "Aspect Ratio",
          "type": "string"
        },
        "production_constraints": {
          "additionalProperties": true,
          "title": "Production Constraints",
          "type": "object"
        }
      },
      "required": [
        "brief_id",
        "title"
      ],
      "title": "CreativeBrief",
      "type": "object"
    },
    "DependencyType": {
      "description": "Typed edges in a ShotDependencyGraph (road_map.md Phase 9).",
      "enum": [
        "TEMPORAL",
        "VISUAL_REFERENCE",
        "CONTINUITY",
        "TRANSITION",
        "DIALOGUE",
        "ASSET"
      ],
      "title": "DependencyType",
      "type": "string"
    },
    "DialogueLine": {
      "additionalProperties": true,
