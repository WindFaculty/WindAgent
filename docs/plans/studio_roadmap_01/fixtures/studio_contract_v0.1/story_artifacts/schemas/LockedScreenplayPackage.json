{
  "$defs": {
    "PackageArtifactRef": {
      "description": "Manifest entry: immutable reference to an approved artifact.",
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        }
      },
      "required": [
        "artifact_type",
        "artifact_id",
        "content_hash"
      ],
      "title": "PackageArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Immutable lock-ready package: manifest of approved artifact refs.\n\nThe manifest IS the content: it references immutable approved artifacts by\n``(artifact_id, content_hash, revision_id)`` and never copies a mutable\nin-memory draft as authority (cross-cutting rule 7).",
  "properties": {
    "artifact_type": {
      "default": "LockedScreenplayPackage",
      "title": "Artifact Type",
      "type": "string"
    },
    "assembled_at": {
      "format": "date-time",
      "title": "Assembled At",
      "type": "string"
    },
    "manifest": {
      "items": {
        "$ref": "#/$defs/PackageArtifactRef"
      },
      "title": "Manifest",
      "type": "array"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "default": "studio.artifact/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "receipt_id",
    "title"
  ],
  "title": "LockedScreenplayPackage",
  "type": "object"
}
