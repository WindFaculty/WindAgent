# WindAgent local development environment — placeholders only.
#
# SCOPE: this file documents overrides for DOCKER COMPOSE ONLY. docker compose
# auto-loads a repo-root `.env` (copy this template there) and interpolates
# ${VAR} inside compose.yaml from it. Nothing else in the repository reads
# `.env` — the API, Worker, and pytest read real process-environment variables
# set in your shell or set automatically by scripts/dev_postgres.py.
#
# NEVER put real credentials in this file or in `.env`: development database
# credentials are intentionally pinned inside compose.yaml to mirror the CI
# service containers (test:test / windagent) and must not be duplicated here.

# Host port for the Dockerized PostgreSQL. Precedence across all tooling:
#   scripts/dev_postgres.py --port flag  >  shell environment variable
#   >  this .env value  >  default 55432
# The wrapper injects the resolved value into `docker compose`, so the
# published mapping can never drift from the URL it dials.
WINDAGENT_POSTGRES_PORT=55432

# To point the API/Worker/a manual pytest at the Dockerized PostgreSQL, set
# this in your SHELL — not here (scripts/dev_postgres.py test sets both PG
# environment variables automatically):
#   PowerShell:
#     $env:WINDAGENT_TEST_POSTGRES_URL = "postgresql+asyncpg://test:test@localhost:55432/windagent"
#     $env:WINDAGENT_DATABASE_URL = $env:WINDAGENT_TEST_POSTGRES_URL
