# WindAgent V2 local development environment — placeholders only.
#
# SCOPE: docker compose interpolates ${VAR} from a repo-root `.env` copied
# from this file.  Nothing else reads `.env` automatically except
# windagent.platform.configuration.Settings (pydantic-settings env_file).
#
# NEVER put real credentials here.  Development database credentials are
# intentionally pinned inside compose.yaml and mirror the CI service
# containers.  Port 55433 keeps the V2 cluster separate from the OLD
# WindAgent dev database (55432) and machine-local PostgreSQL (5432).

WINDAGENT_POSTGRES_PORT=55433

# API/worker/CLI configuration (process environment takes precedence):
#   PowerShell:
#     $env:WINDAGENT_ENVIRONMENT = "development"
#     $env:WINDAGENT_DATABASE_URL = "postgresql+asyncpg://windagent:windagent@localhost:55433/windagent_v2"

# Phase 10 observability defaults:
# WINDAGENT_LOG_LEVEL=INFO
# WINDAGENT_METRICS_ENABLED=true
