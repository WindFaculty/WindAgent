# Evidence hash/checksum files must be byte-stable so sha256 values recorded in
# integrity manifests match on every platform (no autocrlf normalization).
*.sha256        text eol=lf
*.sha256sum     text eol=lf
checksums.sha256 text eol=lf

# Handoff-pinned component trees and phase evidence are part of the integrity
# contract (scripts/verification/verify_phase03_handoff.py hashes their raw
# bytes). Force LF on every platform so a Windows dev checkout and the Linux
# CI runner see identical bytes.
artifacts/video_production/**  text eol=lf
docs/video_production/**       text eol=lf
core/windagent_core/contracts/video_production/** text eol=lf
core/windagent_core/events/video_production.py    text eol=lf
tests/fixtures/video_production/**             text eol=lf

# Vendored upstream snapshot: the phase-4 intake verifier hashes raw bytes,
# so git must never apply any conversion to it (-text keeps every platform's
# checkout byte-identical to what was committed).
third_party/**                 -text
