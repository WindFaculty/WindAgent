+# ---------- Seed canonical models from existing catalog (migration helper) ----------
+
+async def seed_canonical_models(db) -> int:
+    """One-time migration: derive canonical_models + bindings from catalog.
+
+    Non-destructive: inserts only rows whose canonical id does not already
+    exist. Returns number of canonical models created.
+    """
+    from sqlalchemy import select, text
+
+    async with db.session() as s:
+        res = await s.execute(select(CanonicalModelORM))
+        existing = {row.id for row in res.scalars().all()}
+        res = await s.execute(select(ModelCatalogORM))
+        rows = res.scalars().all()
+
+        created = 0
+        for c in rows:
+            # vendor derived from provider id; canonical identity = model_id
+            vendor = (c.provider_id or "unknown").split("/")[0].split("-")[0]
+            canonical_id = c.model_id
+            if canonical_id in existing:
+                continue
+            family = canonical_id.split("/")[-1] if "/" in canonical_id else canonical_id
+            s.add(CanonicalModelORM(
+                id=canonical_id,
+                vendor=vendor,
+                family=family,
+                canonical_name=c.display_name or canonical_id,
+                context_window=c.context_window,
+                capabilities_json=c.capabilities_json,
+                tool_call_protocol="openai" if c.type == "API" else None,
+                enabled=c.enabled,
+            ))
+            s.add(ProviderModelBindingORM(
+                id=f"{c.provider_id}:{c.model_id}",
+                canonical_model_id=canonical_id,
+                provider_id=c.provider_id,
+                provider_model_id=c.model_id,
+                priority=50,
+                enabled=c.enabled,
+                supports_streaming=True,
+                supports_tools=True,
+            ))
+            existing.add(canonical_id)
+            created += 1
+    return created
+
